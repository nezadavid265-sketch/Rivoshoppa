# Copy this file to .env and replace the values with your provider credentials.

# Google Maps JavaScript API browser key. Restrict it by website referrer and API.
GOOGLE_MAPS_API_KEY=replace-with-a-referrer-restricted-browser-key

# Gmail SMTP notifications. Use a Google app password, not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=rivoshoppa1@gmail.com
SMTP_PASS=replace-with-a-16-character-google-app-password
SMTP_FROM="Rivoshoppa <rivoshoppa1@gmail.com>"

# Mobile Money account shown in customer payment SMS
MOMO_ACCOUNT_NUMBER=2267783
MOMO_ACCOUNT_NAME=Rivoshoppa

# Payment providers (Rwanda / official merchant credentials required)
MTN_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_ENVIRONMENT=sandbox
MTN_API_USER_ID=replace-with-mtn-api-user-id
MTN_API_KEY=replace-with-mtn-api-key
MTN_SUBSCRIPTION_KEY=replace-with-mtn-subscription-key
MTN_CALLBACK_URL=https://example.com/api/payments/webhook/mtn_mobile_money
MTN_CALLBACK_SECRET=replace-with-mtn-callback-secret

AIRTEL_API_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_ENVIRONMENT=sandbox
AIRTEL_CLIENT_ID=replace-with-airtel-client-id
AIRTEL_CLIENT_SECRET=replace-with-airtel-client-secret
AIRTEL_MERCHANT_ID=replace-with-airtel-merchant-id
AIRTEL_CALLBACK_URL=https://example.com/api/payments/webhook/airtel_money
AIRTEL_CALLBACK_SECRET=replace-with-airtel-callback-secret

# SMS notifications (Twilio)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15005550006
